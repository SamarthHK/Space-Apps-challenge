# Copy to .env at the repository root. Never commit .env or database backups.
# Use one hostname for both browser-facing services. Public/wildcard binds are rejected.
APP_HOST=127.0.0.1
FRONTEND_PORT=1080
API_PORT=8080

POSTGRES_DB=bhumi
POSTGRES_USER=bhumi
# Required: choose a long random database password. This is NOT an app login.
POSTGRES_PASSWORD=

# Native connection / Docker's loopback-only database port.
# Compose overrides the application containers to use db:5432 internally.
DB_HOST=127.0.0.1
DB_PORT=55432

CANONICAL_SCHEMA=agri_bhumi_data
WORKSPACE_SCHEMA=agri_bhumi_workspace
DEPLOYMENT_ID=bhumi
AUTH_SESSION_SECONDS=43200
