# Environment Configuration for Agri-Data Platform

# Database (PostgreSQL/PostGIS or SQLite fallback)
DATABASE_URL=sqlite:///data/agri_data.db
# For PostgreSQL / PostGIS:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_db

# File Storage Paths
DATA_DIR=data
CACHE_DIR=data/cache
EXPORTS_DIR=data/exports
LOG_DIR=logs

# External API Configuration
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPENAQ_BASE_URL=https://api.openaq.org/v2
FAOSTAT_BASE_URL=https://fenixservices.fao.org/faostat/api/v1/en

# Earth Engine and Copernicus CDS (optional / where configured)
EE_PROJECT_ID=
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=

# Processing & Logging
LOG_LEVEL=INFO
DEFAULT_CRS=EPSG:4326
EQUAL_AREA_CRS=EPSG:6933
DEFAULT_REGION=Karnataka
