# Reference configuration only; CLI reads the process environment, not this file.
# Supply a password using PGPASSFILE or your secret manager. Never commit secrets.
DATABASE_URL=postgresql://agri_acceptance@127.0.0.1:55439/agri_acceptance
POSTGRES_DB=agri_acceptance
POSTGRES_USER=agri_acceptance
POSTGRES_PORT=55439
# Docker Compose additionally requires POSTGRES_PASSWORD in its environment.
# PostgreSQL/PostGIS is mandatory. No SQLite, demo data or fallback is supported.

# Account deployment additionally requires the explicit canonical/workspace
# settings and provisioning in docs\private_workspace.md.
# AGRI_AUTH_MODE=accounts
# AGRI_AUTH_COOKIE_SECURE=false
# AGRI_AUTH_SESSION_SECONDS=43200
